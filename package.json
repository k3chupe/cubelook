{
  "name": "cubelook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify && tsc && vite build",
    "preview": "vite preview",
    "data": "tsx scripts/build-data.ts",
