  },
  "devDependencies": {
    "@accesslint/cli": "^0.13.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "cubing": "^0.65.1"
  }
}
